# ==========================================
# NATURE SCOPE - .gitignore
# Node.js + React + Vite + Supabase
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
.npm/

# Build files
dist/
build/
.next/
out/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/

# Cache and temporary files
.cache/
.tmp/
temp/
*.tmp
*.temp

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains IDEs
.idea/
*.iml

# Editor temporary files
*.swp
*.swo
*~

# Local database files
*.sqlite
*.sqlite3
*.db

# Supabase local files
supabase/.temp/
supabase/.branches/

# Vercel
.vercel/

# Netlify
.netlify/

# Python cache
*pycache*/
*.py[cod]

# Backup files
*.bak
*.backup

# Package manager cache
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Firebase
.firebase/

# Local uploads - if applicable
uploads/
