# ==========================================
# Nature Scope - Root .gitignore
# React + Vite (Frontend) & Node.js + Express (Backend)
# ==========================================

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnpm-store/
.npm/

# Build outputs
dist/
build/
frontend/dist/
backend/dist/

# Environment and secrets
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & coverage
coverage/

# Cache & temporary files
.cache/
.tmp/
temp/
*.tmp
*.temp
.vite/
frontend/.vite/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Uploads
uploads/
backend/uploads/
